{
  "name": "@taskboard/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "check-types": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "lint": "node node_modules/oxlint/bin/oxlint src",
    "test": "node node_modules/vitest/vitest.mjs run",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "@taskboard/typescript-config": "workspace:*",
    "@types/node": "26.6.4",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
