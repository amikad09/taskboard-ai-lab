{
  "$schema": "https://unpkg.com/knip@6.40.0/schema.json",
  "ignoreBinaries": ["encore"],
  "workspaces": {
    ".": {
      "entry": ["tests/browser/**/*.ts"],
      "project": ["tests/**/*.ts", "*.config.ts"]
    },
    "apps/backend": {
      "entry": [
        "services/taskboard/encore.service.ts",
        "services/taskboard/api/**/*.ts",
        "services/taskboard/tests/**/*.ts"
      ],
      "project": ["services/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts", "tests/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/taskboard-core": {
      "entry": ["src/index.ts", "tests/**/*.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/typescript-config": {
      "entry": [],
      "project": []
    }
  }
}
